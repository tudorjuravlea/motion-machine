  "essence": {
    "traits": [
      "Headlines rise a short way and settle without a bounce, so nothing overshoots its mark.",
      "Every scene rests for at least a second and a half before anything changes: the frame is still more often than it moves.",
      "Scenes dissolve, push or dip into the next one; a hard cut is kept for the opening.",
      "A group of items arrives in a slow cascade, about seven hundredths of a second apart, and finishes within a second."
    ],
    "notLike": [
      {
        "style": "premium",
        "line": "premium also moves slowly, but its headlines come in out of blur and its springs give a faint bounce; calm never blurs and never bounces."
      },
      {
        "style": "proof",
        "line": "proof is as still as calm but cuts hard between every scene; calm lets each scene dissolve or slide into the next."
      }
    ]
  },
  "nativeMoves": [
    {
      "move": "The push cut: the next scene slides in carrying the previous one out, used when two scenes are about the same subject.",
      "transfer": "A cooking class film where each recipe step pushes in from the side, so the steps read as one continuing hand."
    },
    {
      "move": "A single zoom-through held back for the turn of the film, with everything before it quiet.",
      "transfer": "An onboarding film that stays still until the moment the product first shows the viewer their own data, and zooms through only there."
    },
    {
      "move": "A colour dip as the closing cut: the last scene fades into a flat brand colour rather than to black.",
      "transfer": "A quarterly letter to members that ends on a dip to the canvas colour, then the sign-off line."
    }
  ],
  "pitfalls": [
    {
      "mistake": "Packing in more than about five arrivals every ten seconds.",
      "mechanism": "The 1.6 second hold floor collapses and the slow eases read as lag, so the frame is always mid-move and never rests.",
      "fix": "Cut beats until each scene carries one idea, or move to kinetic if the content really is dense."
    },
    {
      "mistake": "Using slam, punch or drop entrances on a calm style.",
      "mechanism": "A hard-edged entrance has no soft landing to meet the 0.05 overshoot ceiling, so it looks clipped against the dissolves around it.",
      "fix": "Keep to rise, fade, count and pop; ask for emphasis from the colour or the hold, not the entrance."
    },
    {
      "mistake": "Hard-cutting every scene to save time.",
      "mechanism": "Calm leans on the dissolve to carry one scene into the next; without it, scenes sit side by side as separate slides.",
      "fix": "Leave topic as crossfade and related as push, or choose proof if the film should cut."
    }
  ],
  "variation": {
    "free": [
      "Which scenes take the push and which the crossfade, within the topic and related roles.",
      "Scene length, from the 1.6 second hold floor upward.",
      "A fade in place of a rise for a headline that should arrive quieter.",
      "Where the one zoom-through lands, and the colour of the closing dip (any palette role)."
    ],
    "invariants": [
      "No overshoot beyond 0.05.",
      "A hold floor of 1.6 seconds and no more than five arrivals per ten seconds.",
      "A hard cut only as the opening.",
      "Durations stay at 240, 520 and 1000 ms."
    ]
  }
