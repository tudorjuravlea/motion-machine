    {
      "id": "f1",
      "text": "A 30-second film at 30 frames per second is 900 frames, each drawn from t alone.",
      "source": "SPEC §2"
    },
    {
      "id": "f2",
      "text": "The gate checks 53 rules: 14 errors and 39 warnings.",
      "source": "SPEC §7"
    },
    {
      "id": "f3",
      "text": "The same story renders as a film and as a clicker deck from one scene model.",
      "source": "SPEC §1, §10"
    }
  ],
