{
 "title": "Screen actions",
 "sub": "What happens on a device screen.",
 "style": "editorial",
 "template": "scenes",
 "items": [
  {
   "pattern": "screen/scroll",
   "template": "scenes",
   "scenes": [
    {
     "layout": "layouts/caption-bar",
     "duration": 5,
     "beats": [
      {
       "at": 0,
       "slot": "stage",
       "fx": "devices/phone",
       "asset": "assets/app/",
       "params": {
        "size": "large",
        "instant": true
       },
       "screen": [
        {
         "do": "screen/scroll",
         "at": 0.8,
         "params": {
          "to": "Pricing"
         }
        }
       ]
      },
      {
       "at": 0.4,
       "slot": "caption",
       "fx": "entrances/fade",
       "text": "scroll: the page glides to a named mark."
      }
     ]
    },
    {
     "layout": "layouts/caption-bar",
     "duration": 4.6,
     "beats": [
      {
       "at": 0,
       "slot": "stage",
       "fx": "devices/phone",
       "asset": "assets/app/",
       "params": {
        "size": "large",
        "instant": true
       },
       "screen": [
        {
         "do": "screen/scroll",
         "at": 0.6,
         "params": {
          "to": "Start",
          "align": "center",
          "settle": 1
         }
        }
       ]
      },
      {
       "at": 0.3,
       "slot": "caption",
       "fx": "entrances/fade",
       "text": "align center, settle 1: more momentum."
      }
     ]
    }
   ],
   "assets": [
    {
     "from": "patterns/screen/scroll/demo/assets/app",
     "to": "assets/app"
    }
   ]
  },
