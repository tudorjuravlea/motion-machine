  {
   "pattern": "screen/swap",
   "template": "scenes",
   "scenes": [
    {
     "layout": "layouts/caption-bar",
     "duration": 4.8,
     "beats": [
      {
       "at": 0,
       "slot": "stage",
       "fx": "devices/phone",
       "asset": "assets/app/",
       "params": {
        "size": "large",
        "instant": true
       },
       "screen": [
        {
         "do": "screen/tap",
         "at": 0.8,
         "params": {
          "at": "40%,30%"
