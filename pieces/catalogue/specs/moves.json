{
  "title": "Camera moves",
  "sub": "The camera, not the content, moves.",
  "style": "calm-product",
  "template": "move",
  "items": [
    { "pattern": "moves/hold", "how": "The camera stays still, chosen by name.", "knob": { "line": "No knobs: stillness on purpose.", "moveParams": {} } },
    { "pattern": "moves/idle-breathe", "how": "A faint swell keeps a held frame alive.", "knob": { "line": "amount: 0.012, cycles: 4. Quicker breaths.", "moveParams": { "amount": 0.012, "cycles": 4 } } },
    { "pattern": "moves/ken-burns", "how": "A slow zoom with a small sideways creep.", "knob": { "line": "dir: left, to: 1.06.", "moveParams": { "dir": "left", "to": 1.06 } } },
    { "pattern": "moves/pan", "how": "The camera slides; the content moves the other way.", "knob": { "line": "dir: up, d: 160. A longer sweep.", "moveParams": { "dir": "up", "d": 160 } } },
    { "pattern": "moves/push-in", "how": "The camera drifts in toward the scene.", "knob": { "line": "to: 1.2, toward the figure.", "moveParams": { "to": 1.2, "focus": "figure" } } },
    { "pattern": "moves/pull-back", "how": "Starts close, then settles back to the full frame.", "knob": { "line": "from: 1.3. It starts closer.", "moveParams": { "from": 1.3 } } },
    { "pattern": "moves/reframe", "how": "Re-centres on one element while pushing in.", "knob": { "line": "amount: 0.5. Halfway to the centre.", "moveParams": { "amount": 0.5 } } },
    { "pattern": "moves/orbit", "layout": "layouts/bento-3", "how": "a gentle turn that parallaxes the layers.", "knob": { "line": "turn 10, gap 400.", "moveParams": { "turn": 10, "gap": 400 } } },
    { "pattern": "moves/rack-focus", "layout": "layouts/bento-3", "how": "focus pulls from one depth to another.", "knob": { "line": "rest: keep. Far layers stay soft.", "moveParams": { "rest": "keep" } } },
    { "pattern": "moves/hero-drift", "layout": "layouts/bento-3", "how": "a slow, shallow drift and a breath.", "knob": { "line": "tilt 3, float 40 px.", "moveParams": { "tilt": 3, "d": 40 } } },
    { "pattern": "moves/explode-layers", "layout": "layouts/bento-3", "how": "the layers part in depth, then fold flat.", "minA": 4.3, "minB": 4.3, "knob": { "line": "tilt 35, gap 500.", "moveParams": { "tilt": 35, "gap": 500 } } },
    { "pattern": "moves/morph", "template": "scenes", "scenes": [
      { "layout": "layouts/comparison", "move": "moves/morph", "moveParams": { "from": "left", "to": "headline", "start": 1, "dur": 1.2 }, "min": 4, "beats": [
        { "at": 0, "slot": "left", "fx": "style:body", "text": "This box", "params": { "instant": true } },
        { "at": 0, "slot": "right", "fx": "style:body", "text": "morph: one box travels and becomes another.", "params": { "instant": true } },
        { "at": 0.9, "slot": "headline", "fx": "entrances/fade", "text": "That box" } ] },
      { "layout": "layouts/comparison", "move": "moves/morph", "moveParams": { "from": "left", "to": "headline", "start": 0.6, "dur": 2.4 }, "min": 4, "beats": [
        { "at": 0, "slot": "left", "fx": "style:body", "text": "This box", "params": { "instant": true } },
        { "at": 0, "slot": "right", "fx": "style:body", "text": "dur: 2.4. A slower change.", "params": { "instant": true } },
        { "at": 0.5, "slot": "headline", "fx": "entrances/fade", "text": "That box" } ] } ] },
    { "pattern": "moves/shake", "figure": { "text": "Land", "fx": "entrances/slam" }, "how": "the camera jolts on an impact, then is still.", "moveParams": { "hits": "0.7", "amp": 12 },
      "knob": { "line": "two hits, amp 28, decay 0.6.", "moveParams": { "hits": "0.7, 1.9", "amp": 28, "decay": 0.6 } } },
    { "pattern": "moves/depth-parallax", "template": "scenes", "scenes": [
      { "layout": "layouts/media", "move": "moves/depth-parallax", "moveParams": { "path": "dolly-right" }, "min": 5.4, "beats": [
        { "at": 0, "slot": "image", "fx": "entrances/fade", "asset": "assets/scene/source.png", "params": { "instant": true, "frame": "bleed" } },
        { "at": 0.4, "slot": "headline", "fx": "entrances/rise", "text": "depth-parallax" },
        { "at": 1.4, "slot": "caption", "fx": "entrances/fade", "text": "A still becomes a dolly shot; far layers slide and soften." } ] },
      { "layout": "layouts/media", "move": "moves/depth-parallax", "moveParams": { "path": "push", "amount": 0.2 }, "min": 4.6, "beats": [
        { "at": 0, "slot": "image", "fx": "entrances/fade", "asset": "assets/scene/source.png", "params": { "instant": true, "frame": "bleed" } },
        { "at": 0.4, "slot": "headline", "fx": "entrances/rise", "text": "depth-parallax" },
        { "at": 1.4, "slot": "caption", "fx": "entrances/fade", "text": "path: push, amount: 0.2. Pushes in instead." } ] } ],
      "assets": [{ "from": "patterns/moves/depth-parallax/demo/assets/scene", "to": "assets/scene" }] },
    { "pattern": "moves/punch", "lead": true, "footage": "assets/talk/", "template": "scenes", "scenes": [
      { "layout": "layouts/talking-full", "duration": 8.8, "move": "moves/punch", "moveParams": { "x": 50, "y": 35 }, "beats": [
        { "at": 0, "slot": "headline", "fx": "entrances/rise", "text": "punch: every other clip moves closer", "params": { "instant": true } },
        { "at": 0.8, "slot": "caption", "fx": "entrances/rise", "text": "scale 1.15 by default; the eye line never moves." } ] } ],
      "assets": [{ "from": "patterns/moves/punch/demo/assets/talk", "to": "assets/talk" }, { "from": "patterns/moves/punch/demo/assets/talk.licence.json", "to": "assets/talk.licence.json" }] }
  ]
}
