{
  "title": "Text",
  "sub": "Type that moves as it lands.",
  "style": "calm-product",
  "template": "figure",
  "items": [
    { "pattern": "text/caption-karaoke", "figure": { "text": "Light each word" }, "how": "Lights the words of each group in turn.",
