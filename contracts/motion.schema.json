{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:motion-machine:contracts:motion",
  "title": "Motion Machine motion half (SPEC §3): how things move and sound",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "motion", "sound", "transitions", "entrances", "pacing"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" },
    "version": { "type": "integer", "minimum": 1 },
    "source": { "type": "string", "description": "for a captured motion style: what reference it was measured from (a description, never a path the piece loads)" },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durations", "easings", "spring", "travel", "overshootMax", "exitRatio", "stagger"],
      "properties": {
        "durations": {
          "type": "object", "additionalProperties": false,
          "required": ["quick", "standard", "slow", "hold"],
          "properties": {
            "quick":    { "type": "integer", "minimum": 60,  "maximum": 600,  "description": "ms" },
            "standard": { "type": "integer", "minimum": 150, "maximum": 1200 },
            "slow":     { "type": "integer", "minimum": 300, "maximum": 3000 },
            "hold":     { "type": "integer", "minimum": 500, "maximum": 6000 }
          }
        },
        "easings": {
          "type": "object", "additionalProperties": false,
          "required": ["enter", "exit", "move"],
          "properties": {
            "enter": { "$ref": "#/$defs/easing" },
            "exit":  { "$ref": "#/$defs/easing" },
            "move":  { "$ref": "#/$defs/easing" }
          }
        },
        "spring": {
          "type": "object", "additionalProperties": false,
          "required": ["ui", "type", "heavy"],
          "properties": {
            "ui":    { "$ref": "#/$defs/spring" },
            "type":  { "$ref": "#/$defs/spring" },
            "heavy": { "$ref": "#/$defs/spring" }
          }
        },
        "travel":       { "type": "number", "minimum": 0.25, "maximum": 3 },
        "overshootMax": { "type": "number", "minimum": 0, "maximum": 0.3, "description": "SPEC §15: bounded by the motion style" },
        "exitRatio":    { "type": "number", "minimum": 0.4, "maximum": 1 },
        "frameHold":    { "type": "integer", "enum": [1, 2, 3], "description": "2 animates elements on twos and 3 on threes (a 10 fps stop-motion grid): elements change only on the shared grid of 2/30 s or 3/30 s, counted in 1/30 s whatever the export frame rate, and an element that would finish inside its last step is drawn finished from that step, so rests are the same with or without the hold; cuts and camera moves stay smooth. Optional, 1 by default" },
        "boil":         { "type": "number", "minimum": 0, "maximum": 2, "description": "seconds each frame of a pen stroke's shiver holds (entrances/sketch); 0 keeps strokes still. Optional, 0.4 by default; a deck never shivers" },
        "stagger": {
          "type": "object", "additionalProperties": false,
          "required": ["eachS", "capS"],
          "properties": {
            "eachS": { "type": "number", "minimum": 0.01, "maximum": 0.25 },
            "capS":  { "type": "number", "minimum": 0.2, "maximum": 1.5 }
          }
        }
      }
    },
    "sound": {
      "type": "object", "additionalProperties": false,
      "required": ["palette", "bpm", "loudnessLufs", "cuesPer10s"],
      "properties": {
        "palette":      { "type": "string", "enum": ["soft-ui", "percussive", "cinematic", "none"] },
        "bpm":          { "type": "integer", "minimum": 50, "maximum": 200 },
        "loudnessLufs": { "type": "number", "minimum": -24, "maximum": -9 },
        "cuesPer10s":   { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 0, "maximum": 12 } },
        "profile":      { "type": "string", "minLength": 1, "maxLength": 200, "description": "the sound profile (contracts/sound-profile.schema.json) the cues are voiced in and measured against: a name in styles/sound/ or a path to a profile file. The brand half may set it too, and then it wins, so a brand chooses its sound once" },
        "samples":      { "type": "object", "maxProperties": 40, "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,30}$" }, "additionalProperties": { "type": "string", "pattern": "^(?!https?:)[^\\s]+\\.(wav|mp3|m4a|flac|ogg)$" }, "description": "cue name -> a sound file in the piece (assets/sounds/x.wav) that `mm sound` mixes in place of the cue's synthesis: trimmed and gain-matched to the profile's level. The cue must still exist under patterns/sound/ (the live preview plays it). Every file needs a record beside it, assets/sounds/x.json (contracts/sound-sample.schema.json): W-SAMPLE-LICENSE. A story's `audio.samples` wins over this" }
      }
    },
    "transitions": {
      "type": "object", "additionalProperties": false,
      "required": ["opening", "topic", "related", "climax", "outro", "policy"],
      "properties": {
        "opening": { "$ref": "#/$defs/patternRef" },
        "topic":   { "$ref": "#/$defs/patternRef" },
        "related": { "$ref": "#/$defs/patternRef" },
        "climax":  { "$ref": "#/$defs/patternRef" },
        "outro":   { "$ref": "#/$defs/patternRef" },
        "policy":  { "type": "string", "enum": ["owns-exit", "velocity-matched"], "description": "SPEC §15: the transition owns the exit by default" }
      }
    },
    "entrances": {
      "type": "object", "additionalProperties": false,
      "required": ["headline", "body", "figure", "plate"],
      "properties": {
        "headline": { "$ref": "#/$defs/patternRef" },
        "body":     { "$ref": "#/$defs/patternRef" },
        "figure":   { "$ref": "#/$defs/patternRef" },
        "plate":    { "$ref": "#/$defs/patternRef" }
      }
    },
    "pacing": {
      "type": "object", "additionalProperties": false,
      "required": ["holdMinS", "arrivalsPer10s", "energy"],
      "properties": {
        "holdMinS":       { "type": "number", "minimum": 0.3, "maximum": 4 },
        "arrivalsPer10s": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 0, "maximum": 20 } },
        "energy":         { "type": "string", "enum": ["calm", "medium", "high"] }
      }
    },
    "gate": {
      "type": "object", "additionalProperties": false,
      "description": "tunes the gate's warnings for this style; hard (G-) rules have no entry here and the schema refuses one. Every key is optional and each tuned rule reports the threshold it used",
      "properties": {
        "length": {
          "type": "object", "additionalProperties": false,
          "description": "W-LENGTH's bands, each [min, max]: the film in seconds, a looping post in seconds, a deck in presses",
          "properties": {
            "filmS":       { "$ref": "#/$defs/band" },
            "loopS":       { "$ref": "#/$defs/band" },
            "deckPresses": { "$ref": "#/$defs/band" }
          }
        },
        "deadS":  { "type": "number", "exclusiveMinimum": 0, "maximum": 60, "description": "W-DEAD: the longest window of a film with no arrival, departure, cut or move, in seconds" },
        "quietS": { "type": "number", "minimum": 0, "maximum": 30, "description": "W-QUIET: the shortest film tail after the last arrival, in seconds" },
        "read": {
          "type": "object", "additionalProperties": false,
          "description": "W-READ: the reading speed and the floors a line must hold settled",
          "properties": {
            "perWordS": { "type": "number", "exclusiveMinimum": 0, "maximum": 2, "description": "seconds to read one word (a scene needs its words times this, plus its last arrival)" },
            "labelS":    { "type": "number", "exclusiveMinimum": 0, "maximum": 10, "description": "seconds a line of one to three words holds settled" },
            "sentenceS": { "type": "number", "exclusiveMinimum": 0, "maximum": 10, "description": "the least seconds a longer line holds settled (it also needs perWordS per word)" }
          }
        },
        "anchor": {
          "type": "object", "additionalProperties": false,
          "description": "W-ANCHOR: how far a beat may arrive before and after the first word it names, in seconds",
          "properties": {
            "earlyS": { "type": "number", "minimum": 0, "maximum": 10, "description": "the most a beat may arrive before its word" },
            "lateS":  { "type": "number", "minimum": 0, "maximum": 10, "description": "the most a beat may arrive after its word" }
          }
        },
        "tokens": {
          "type": "object", "additionalProperties": false,
          "description": "W-TOKENS: the most distinct values a piece may use of each kind at its rests",
          "properties": {
            "strokes": { "type": "integer", "minimum": 1, "maximum": 40, "description": "stroke and border widths" },
            "sizes":   { "type": "integer", "minimum": 1, "maximum": 40, "description": "font sizes" },
            "radii":   { "type": "integer", "minimum": 1, "maximum": 40, "description": "corner radii" }
          }
        },
        "sameBox": {
          "type": "object", "additionalProperties": false,
          "description": "W-SAMEBOX: how many scenes may share one box signature, and from how many scenes the rule reads",
          "properties": {
            "share":     { "type": "number", "minimum": 0, "maximum": 1, "description": "the share of scenes that may carry one signature before the rule warns (more than this)" },
            "minScenes": { "type": "integer", "minimum": 2, "maximum": 40, "description": "the fewest scenes at a rest the rule reads" },
            "quant":     { "type": "number", "exclusiveMinimum": 0, "maximum": 0.5, "description": "the grid, as a share of the frame, that a box is snapped to" }
          }
        },
        "seamPct": { "type": "number", "minimum": 0, "maximum": 100, "description": "W-SEAM: how far apart, in percent, an exit's speed and the next entrance's speed across a cut may be" },
        "liftBans": {
          "type": "array", "uniqueItems": true,
          "description": "looks W-BAN stops warning about for this style, by name; only the three W-BAN detects can be lifted, and the brand's own `bans` and `allow` stay as they are",
          "items": { "enum": ["centered-title-on-gradient", "corner-labels", "frame-borders"] }
        }
      }
    }
  },
  "$defs": {
    "band": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0, "maximum": 3600 } },
    "easing": {
      "type": "string",
      "pattern": "^(linear|ease-in|ease-out|ease-in-out|cubic-bezier\\(\\s*-?[0-9.]+\\s*,\\s*-?[0-9.]+\\s*,\\s*-?[0-9.]+\\s*,\\s*-?[0-9.]+\\s*\\))$"
    },
    "spring": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["k", "c", "m"],
          "properties": {
            "k": { "type": "number", "exclusiveMinimum": 0, "maximum": 2000 },
            "c": { "type": "number", "exclusiveMinimum": 0, "maximum": 200 },
            "m": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["bounce", "period"],
          "properties": {
            "bounce": { "type": "number", "minimum": -1, "exclusiveMaximum": 1, "description": "1 would never settle; the kit floors damping at bounce 0.99" },
            "period": { "type": "number", "exclusiveMinimum": 0, "maximum": 5, "description": "seconds" }
          }
        }
      ]
    },
    "patternRef": { "type": "string", "pattern": "^(entrances|exits|emphasis|transitions|layouts|moves|text|data|devices|sound)/[a-z][a-z0-9-]*$" }
  }
}
