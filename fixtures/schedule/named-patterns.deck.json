{
  "id": "motion-machine-deck",
  "kind": "deck",
  "formats": ["16x9"],
  "title": "Motion Machine: stories in motion",
  "language": "en",
  "facts": [
    { "id": "f1", "text": "A 30-second film at 30 frames per second is 900 frames, each drawn from t alone.", "source": "SPEC §2" },
    { "id": "f2", "text": "The gate checks 32 rules: 18 errors and 14 warnings.", "source": "SPEC §7" },
    { "id": "f3", "text": "The same story renders as a film and as a clicker deck from one scene model.", "source": "SPEC §1, §10" }
  ],
  "audio": { "track": null, "bpm": 120, "beats": null },
  "scenes": [
    {
      "id": "hook", "layout": "layouts/title-stack", "presses": 1, "cut": "transitions/hard-cut", "move": null,
      "beats": [
        { "at": 0.0, "step": 1, "slot": "headline", "fx": "entrances/slam", "text": "Most AI video looks like AI video.", "cue": "hit" },
        { "at": 0.9, "step": 1, "slot": "sub", "fx": "entrances/words", "text": "Centred title. Gradient. Everything fades in." }
      ],
      "say": "You have all seen it. The centred title on a gradient, everything fading in, the logo at the end. Fifteen to twenty seconds on this."
    },
    {
      "id": "problem", "layout": "layouts/statement", "presses": 1, "cut": "transitions/push", "move": null,
      "beats": [
        { "at": 0.0, "step": 1, "slot": "headline", "fx": "entrances/rise", "text": "Nobody checks it before you post it." }
      ],
      "say": "The tools got fast. Nothing got careful. Nobody and nothing checks the result before it goes out."
    },
    {
      "id": "time", "layout": "layouts/split", "presses": 2, "cut": "transitions/crossfade", "move": null,
      "beats": [
        { "at": 0.0, "step": 1, "slot": "headline", "fx": "entrances/rise", "text": "Only time moves things." },
        { "at": 0.0, "step": 2, "slot": "figure", "fx": "data/counter", "value": 900, "fact": "f1", "params": { "suffix": " frames" }, "cue": "tick" },
        { "at": 0.3, "step": 2, "slot": "body", "fx": "entrances/fade", "text": "each drawn from t alone", "fact": "f1" }
      ],
      "say": "Here is the mechanism. The whole picture is a function of one number, time. Press. Nine hundred frames in a thirty-second film, and every one of them can be drawn alone, in any order."
    },
    {
      "id": "style", "layout": "layouts/comparison", "presses": 2, "cut": "transitions/push", "move": null,
      "beats": [
        { "at": 0.0, "step": 1, "slot": "headline", "fx": "entrances/rise", "text": "One brand file. One motion file." },
        { "at": 0.6, "step": 1, "slot": "left", "fx": "entrances/pop", "text": "brand: colour, type, space", "cue": "tick" },
        { "at": 0.0, "step": 2, "slot": "right", "fx": "entrances/pop", "text": "motion: tempo, curves, cuts", "cue": "tick", "emphasis": "emphasis/indicate" }
      ],
      "say": "The look is one file: colour, type, spacing. Press. How things move is a second file: tempo, curves, which cut goes where. Any brand can wear any tempo."
    },
    {
      "id": "patterns", "layout": "layouts/bento-3", "presses": 1, "cut": "transitions/crossfade", "move": null,
      "beats": [
        { "at": 0.0, "step": 1, "slot": "headline", "fx": "entrances/rise", "text": "A library of patterns." },
        { "at": 0.6, "step": 1, "slot": "tile-1", "fx": "entrances/pop", "text": "entrances", "cue": "tick" },
        { "at": 0.75, "step": 1, "slot": "tile-2", "fx": "entrances/pop", "text": "transitions", "cue": "tick" },
        { "at": 0.9, "step": 1, "slot": "tile-3", "fx": "entrances/pop", "text": "sound", "cue": "tick" }
      ],
      "say": "Pieces are composed from a library: entrances, transitions, layouts, camera moves, data moments, sound cues. None of them carries a brand; the style file dresses them."
    },
    {
      "id": "gate", "layout": "layouts/stat-hero", "presses": 1, "cut": "transitions/zoom-through", "move": null,
      "beats": [
        { "at": 0.0, "step": 1, "slot": "figure", "fx": "entrances/count", "value": 32, "fact": "f2", "params": { "suffix": " rules" }, "cue": "riser" },
        { "at": 1.2, "step": 1, "slot": "headline", "fx": "entrances/rise", "text": "Measured, not felt." },
        { "at": 1.8, "step": 1, "slot": "body", "fx": "entrances/fade", "text": "determinism · legibility · pacing · style · sound" }
      ],
      "say": "And a gate measures every result: thirty-two rules, from determinism to legibility at phone size to loudness. Nothing ships on a feeling."
    },
    {
      "id": "both", "layout": "layouts/split", "presses": 1, "cut": "transitions/push", "move": null,
      "beats": [
        { "at": 0.0, "step": 1, "slot": "headline", "fx": "text/kinetic-words", "text": "One brief. A film and a deck.", "fact": "f3" },
        { "at": 1.2, "step": 1, "slot": "caption", "fx": "text/caption-karaoke", "text": "Povești în mișcare" }
      ],
      "say": "The same story you are watching as a deck is also a thirty-second film, from the same file. Stories in motion."
    },
    {
      "id": "cta", "layout": "layouts/endcard", "presses": 1, "cut": "transitions/color-dip", "move": null,
      "beats": [
        { "at": 0.0, "step": 1, "slot": "headline", "fx": "entrances/fade", "text": "motion-machine", "cue": "complete" },
        { "at": 0.5, "step": 1, "slot": "body", "fx": "entrances/fade", "text": "github.com/tudorjuravlea/motion-machine" }
      ],
      "say": "It is open source. Try it on your own brand."
    }
  ],
  "cta": { "text": "motion-machine on GitHub", "url": "github.com/tudorjuravlea/motion-machine" }
}
