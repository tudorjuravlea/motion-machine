{
  "id": "motion-machine-deck",
  "kind": "deck",
  "formats": ["16x9"],
  "title": "Motion Machine: stories in motion",
  "language": "en",
  "facts": [
    { "id": "f1", "text": "A 30-second film at 30 frames per second is 900 frames, each drawn from t alone.", "source": "SPEC §2" },
    { "id": "f2", "text": "The gate checks 53 rules: 14 errors and 39 warnings.", "source": "SPEC §7" },
    { "id": "f3", "text": "The same story renders as a film and as a clicker deck from one scene model.", "source": "SPEC §1, §10" }
  ],
  "audio": { "track": null, "bpm": 120, "beats": null },
  "scenes": [
    {
      "id": "hook", "layout": "layouts/statement", "presses": 1, "position": "opening", "move": null,
      "beats": [
        { "at": 0, "step": 0, "slot": "headline", "fx": "style:headline", "text": "Most AI video looks like AI video." },
        { "at": 0, "step": 1, "slot": "sub", "fx": "style:body", "text": "Centred title. Gradient. Everything fades in.", "cue": "tick" }
      ],
      "say": "You have all seen it. The centred title on a gradient, everything fading in, the logo at the end. Fifteen to twenty seconds on this."
    },
    {
      "id": "problem", "layout": "layouts/title-stack", "presses": 1, "position": "related", "move": null,
      "beats": [
        { "at": 0, "step": 1, "slot": "headline", "fx": "style:headline", "text": "Nobody checks it before you post it.", "cue": "tick" }
      ],
      "say": "The tools got fast. Nothing got careful. Nobody and nothing checks the result before it goes out."
    },
    {
      "id": "time", "layout": "layouts/split", "presses": 1, "position": "topic", "move": null,
      "beats": [
        { "at": 0, "step": 1, "slot": "headline", "fx": "style:headline", "text": "Only time moves things." },
        { "at": 0, "step": 1, "slot": "figure", "fx": "style:figure", "value": 900, "text": "900", "fact": "f1", "cue": "tick" },
        { "at": 0, "step": 1, "slot": "body", "fx": "style:body", "text": "frames, each drawn from t alone", "fact": "f1" }
      ],
      "say": "Here is the mechanism. The whole picture is a function of one number, time. Nine hundred frames in a thirty-second film, and every one of them can be drawn alone, in any order."
    },
    {
      "id": "style", "layout": "layouts/comparison", "presses": 1, "position": "related", "move": null,
      "beats": [
        { "at": 0, "step": 1, "slot": "headline", "fx": "style:headline", "text": "One brand file. One motion file." },
        { "at": 0, "step": 1, "slot": "left", "fx": "style:plate", "text": "brand: colour, type, space", "cue": "tick" },
        { "at": 0, "step": 1, "slot": "right", "fx": "style:plate", "text": "motion: tempo, curves, cuts", "emphasis": "emphasis/indicate" }
      ],
      "say": "The look is one file: colour, type, spacing. How things move is a second file: tempo, curves, which cut goes where. Any brand can wear any tempo."
    },
    {
      "id": "patterns", "layout": "layouts/bento-3", "presses": 1, "position": "topic", "move": null,
      "beats": [
        { "at": 0, "step": 1, "slot": "headline", "fx": "style:headline", "text": "A library of patterns." },
        { "at": 0.4, "step": 1, "slot": "tile-1", "fx": "style:plate", "text": "entrances", "cue": "tick" },
        { "at": 0.5, "step": 1, "slot": "tile-2", "fx": "style:plate", "text": "transitions" },
        { "at": 0.6, "step": 1, "slot": "tile-3", "fx": "style:plate", "text": "sound" }
      ],
      "say": "Pieces are composed from a library: entrances, transitions, layouts, camera moves, data moments, sound cues. None of them carries a brand; the style file dresses them."
    },
    {
      "id": "gate", "layout": "layouts/stat-hero", "presses": 2, "position": "climax", "move": null, "cutParams": { "amount": 0 },
      "beats": [
        { "at": 0.5, "step": 1, "slot": "figure", "fx": "style:figure", "value": 53, "text": "53 rules", "fact": "f2", "params": { "suffix": " rules" }, "cue": "riser" },
        { "at": 0, "step": 2, "slot": "headline", "fx": "style:headline", "text": "Measured, not felt." },
        { "at": 0, "step": 2, "slot": "body", "fx": "style:body", "text": "determinism · legibility · pacing · style · sound" }
      ],
      "say": "And a gate measures every result: forty-seven rules, from determinism to legibility at phone size to loudness. Press. Nothing ships on a feeling."
    },
    {
      "id": "both", "layout": "layouts/statement", "presses": 1, "position": "related", "move": null,
      "beats": [
        { "at": 0, "step": 1, "slot": "headline", "fx": "style:headline", "text": "Povești în mișcare", "cue": "hit" },
        { "at": 0, "step": 1, "slot": "sub", "fx": "style:body", "text": "One story: a film and a deck.", "fact": "f3" }
      ],
      "say": "Stories in motion. The same story you are watching as a deck is also a thirty-second film, from the same file."
    },
    {
      "id": "cta", "layout": "layouts/endcard", "presses": 2, "position": "outro", "move": null,
      "beats": [
        { "at": 0, "step": 1, "slot": "headline", "fx": "style:headline", "text": "One brief. Any style. Checked.", "cue": "complete" },
        { "at": 0, "step": 2, "slot": "body", "fx": "style:body", "text": "github.com/tudorjuravlea/motion-machine" }
      ],
      "say": "One brief, any style, checked before you show it. It is open source. Try it on your own brand."
    }
  ],
  "cta": { "text": "One brief. Any style. Checked.", "url": "github.com/tudorjuravlea/motion-machine" }
